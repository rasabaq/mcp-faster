{
  "name": "mcp-faster",
  "version": "0.1.0",
  "description": "Make MCP servers cheaper and faster for agents: measurement, tool consolidation, caching, response compaction.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "proxy",
    "cache",
    "claude",
    "agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rasabaq/mcp-faster.git"
  },
  "homepage": "https://github.com/rasabaq/mcp-faster#readme",
  "bugs": {
    "url": "https://github.com/rasabaq/mcp-faster/issues"
  },
  "type": "module",
  "bin": {
    "mcp-faster": "dist/cli.js"
  },
  "types": "dist/layer.d.ts",
  "files": [
    "dist",
    "spec",
    "README.md",
    "LICENSE",
    "mcp-gaps.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "site:data": "node src/site/cli.ts",
    "site": "python3 -m http.server 4173 --directory site"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
